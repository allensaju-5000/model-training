graft/.cache/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Downloaded datasets.
/data/

# RF-DETR training runs (checkpoints, logs, exports).
/runs/

# Claude Code: skills ship inside kiln (kiln/skills/) and are installed here with
# `kiln skill install`, so the installed copies and local settings stay untracked.
.claude/

# Python bytecode caches (regenerated on every run).
__pycache__/
*.pyc
